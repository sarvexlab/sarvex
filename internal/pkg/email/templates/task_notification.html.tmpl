<h1 style="font-size:25px;margin:0 0 16px;color:#1C1B18;font-family:Fraunces,Georgia,serif;font-weight:500;">Action needed on {{.MerchantName}}</h1>
<p style="margin:0 0 15px;line-height:1.6;color:#1C1B18;">A new task needs your attention:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F6F5FC;border:1px solid #DAD8F0;border-radius:11px;margin:4px 0 8px;">
<tr><td style="padding:18px 20px;">
<p style="margin:0 0 6px;font-weight:600;color:#1C1B18;line-height:1.4;">{{.TaskTitle}}</p>
{{if .WhyItMatters}}<p style="margin:0;color:#6E6C63;line-height:1.5;font-size:14px;">{{.WhyItMatters}}</p>{{end}}
</td></tr>
</table>
<a href="{{.TaskLink}}" style="display:block;text-align:center;background-color:#5B5BD6;color:#FFFFFF;font-weight:600;padding:15px;border-radius:8px;margin:24px 0 10px;font-size:15px;text-decoration:none;">View task</a>
