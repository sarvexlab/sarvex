<h1 style="font-size:25px;margin:0 0 16px;color:#1C1B18;font-family:Fraunces,Georgia,serif;font-weight:500;">{{.Title}}</h1>
<p style="margin:0 0 15px;line-height:1.6;color:#1C1B18;">{{.Body}}</p>
{{if .CTALink}}<a href="{{.CTALink}}" style="display:block;text-align:center;background-color:#5B5BD6;color:#FFFFFF;font-weight:600;padding:15px;border-radius:8px;margin:24px 0 10px;font-size:15px;text-decoration:none;">{{.CTALabel}}</a>{{end}}
