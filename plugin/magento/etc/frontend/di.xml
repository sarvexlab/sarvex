<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <!--
                    sortOrder=5 runs before the standard router (sortOrder=20) so a
                    request for /.well-known/ucp is claimed here rather than falling
                    through to a 404 (the path has no controller/action segments the
                    standard router could ever resolve).
                -->
                <item name="sarvex_ucp_wellknown" xsi:type="array">
                    <item name="class" xsi:type="string">Sarvex\Ucp\Routing\WellKnownRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">5</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
