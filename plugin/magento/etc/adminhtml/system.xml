<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="sarvex_ucp" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Sarvex UCP Gateway</label>
            <tab>service</tab>
            <resource>Sarvex_Ucp::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Connection</label>
                <field id="endpoint_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Sarvex Endpoint URL</label>
                    <comment>The Sarvex API endpoint, e.g. https://api.sarvex.example.com (no trailing slash).</comment>
                </field>
                <field id="store_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Store ID</label>
                    <comment>Set automatically after pairing via the Sarvex console.</comment>
                    <attribute type="readonly">1</attribute>
                </field>
                <field id="connector_id" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Connector ID</label>
                    <comment>Set automatically after pairing via the Sarvex console.</comment>
                    <attribute type="readonly">1</attribute>
                </field>
                <field id="hmac_secret" translate="label comment" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>HMAC Secret</label>
                    <comment>Set automatically after pairing. Stored encrypted; never share this value.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <attribute type="readonly">1</attribute>
                </field>
            </group>
        </section>
    </system>
</config>
