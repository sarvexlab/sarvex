{
    "name": "sarvex/module-ucp-gateway",
    "description": "Magento 2 integration for Google UCP checkout via Sarvex — signals product/inventory changes to Sarvex and serves the merchant's UCP profile at /.well-known/ucp.",
    "type": "magento2-module",
    "license": "Apache-2.0",
    "version": "1.0.0",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-config": "*",
        "magento/module-store": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Sarvex\\Ucp\\": ""
        }
    }
}
