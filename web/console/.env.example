# Copy to .env.local for overrides. All keys must be prefixed VITE_ to be exposed.

# Base URL for control-plane requests when hitting the real backend.
# Defaults to /api (which only works if you set up a Vite proxy).
# VITE_API_BASE=http://localhost:8081/api

# Vite dev-server proxy: when set, /api → this host so real-backend
# requests are same-origin during dev (no CORS to wire up). 8081 is the
# control plane's port from scripts/dev/lib.sh (started via `make dev-up`).
# `make console-real` sets this (and VITE_USE_MOCKS=0) for you.
# VITE_API_PROXY_TARGET=http://localhost:8081

# ─── Dual-mode routing ────────────────────────────────────────────────────
# The Axios adapter routes each request to mock or real per these env vars.
# See src/api/mocks.ts for the resolution rules.

# Default mode. "1" = mock-by-default (current dev default).
# Set to "0" to flip the default to real-by-default.
VITE_USE_MOCKS=1

# Routes that ALWAYS hit the real backend. Comma-separated path prefixes.
# Useful when most things are still mocked but you want to exercise a
# specific endpoint against the real backend.
# VITE_REAL_ROUTES=/auth/me,/journey

# Routes that ALWAYS hit the mock layer. Comma-separated path prefixes.
# Useful for the inverse: backend is mostly up, but a few endpoints aren't
# ready yet so you keep them mocked.
# VITE_MOCK_ROUTES=/operator,/tasks

# Log each request's resolved mode + path to the browser console.
# VITE_API_DEBUG=1

# ─── Auth ─────────────────────────────────────────────────────────────────
# Identity provider. "simulator" (default) mints JWT-shaped tokens locally
# so the console runs end-to-end without an external IdP. "kinde" uses
# real OAuth 2.0 Authorization Code + PKCE via the Kinde SDK and requires
# the VITE_KINDE_* keys below.
# VITE_AUTH_MODE=kinde

# Kinde config — needed when VITE_AUTH_MODE=kinde.
# Copy from your Kinde dashboard (Settings → Applications → your SPA):
# VITE_KINDE_DOMAIN=https://your-tenant.kinde.com
# VITE_KINDE_CLIENT_ID=...
#
# Default redirect/logout URIs are window.location.origin — override if
# your app runs on a sub-path or you need a dedicated callback route.
# VITE_KINDE_REDIRECT_URI=http://localhost:5173
# VITE_KINDE_LOGOUT_URI=http://localhost:5173
#
# Audience for the access token (required when the backend validates
# `aud`; matches the API identifier in your Kinde tenant).
# VITE_KINDE_AUDIENCE=https://api.sarvex.example.com
#
# Passkeys: enable the Passkey / WebAuthn connection in your Kinde
# tenant (Authentication → Passwordless / Passkey). It then appears on
# the hosted sign-in page automatically — no client changes needed.
