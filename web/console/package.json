{
  "name": "@sarvex/console",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript ../../sarvex-v1-control-plane.yaml -o src/api/schema.d.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-pkce-js": "^4.5.2",
    "axios": "^1.7.7",
    "chart.js": "^4.5.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.4",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "sharp": ">=0.35.5"
  }
}
